# =============================================================================
# Personal AI Agent — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# Application
APP_NAME="Personal AI Agent"
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# Server (desktop launcher forces 127.0.0.1)
HOST=127.0.0.1
PORT=8765

# Database — SQLite for desktop; Postgres optional for server deployments
DATABASE_URL=sqlite+aiosqlite:///./personal_ai.db
DATABASE_URL_SYNC=sqlite:///./personal_ai.db

# LLM Providers — Grok is the PRIMARY provider for desktop
XAI_API_KEY=
# GROK_API_KEY is an alias; XAI_API_KEY is preferred
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_LLM_PROVIDER=grok
DEFAULT_MODEL=grok-3-mini
GROK_DEFAULT_MODEL=grok-3-mini
GROK_FAST_MODEL=grok-3-mini
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# Agent Runtime
MAX_AGENT_STEPS=15
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_RETRIES=2

# Memory
SHORT_TERM_MAX_MESSAGES=50

# Permissions
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
REQUIRE_APPROVAL_FOR_CRITICAL=true

# Local auth between desktop UI and backend
REQUIRE_LOCAL_AUTH=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Observability
ENABLE_COST_TRACKING=true

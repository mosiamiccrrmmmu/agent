# =============================================================================
# Personal AI Agent — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# Application
APP_NAME="Personal AI Agent"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/personal_agent
DATABASE_URL_SYNC=postgresql://agent:agent@localhost:5432/personal_agent

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default models
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-20250514
FAST_MODEL=claude-3-5-haiku-20241022
CODING_MODEL=claude-sonnet-4-20250514

# OpenAI fallbacks
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Agent Runtime
MAX_AGENT_STEPS=15
AGENT_TIMEOUT_SECONDS=120
MAX_TOOL_RETRIES=2

# Memory
SHORT_TERM_MAX_MESSAGES=50
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Permissions
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
REQUIRE_APPROVAL_FOR_CRITICAL=true

# Telegram (Phase 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Observability
ENABLE_COST_TRACKING=true
